--- Dockerfile
+++ Dockerfile (hadofix)
@@ -1,5 +1,8 @@
 FROM python:3.12-slim
 COPY requirements.txt /tmp/requirements.txt
-RUN pip install --no-cache-dir flask
+# hadofix(DL3013): `pip install flask` installs whatever the index serves the
