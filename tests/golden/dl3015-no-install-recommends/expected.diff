--- Dockerfile
+++ Dockerfile (hadofix)
@@ -1,4 +1,7 @@
 FROM debian:bookworm-slim
-RUN apt-get update && apt-get install -y curl=7.88.1-10+deb12u5 && rm -rf /var/lib/apt/lists/*
+# hadofix(DL3015): apt pulls every `Recommends` of every package by default —
+# software nobody in this Dockerfile asked for, shipped in the image and
+# reported by every scanner. The flag installs what is named here and stops.
+RUN apt-get update && apt-get install --no-install-recommends -y curl=7.88.1-10+deb12u5 && rm -rf /var/lib/apt/lists/*
 USER 10001
 CMD ["/usr/local/bin/app"]
