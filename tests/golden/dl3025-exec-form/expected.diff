--- Dockerfile
+++ Dockerfile (hadofix)
@@ -1,3 +1,8 @@
 FROM alpine:3.22
 USER 10001
-CMD /usr/local/bin/app --port 8080
+# hadofix(HF1001): Shell form runs `/bin/sh -c '/usr/local/bin/app --port
+# 8080'`, so PID 1 is sh. `docker stop` sends SIGTERM to PID 1, sh does not
+# forward it, and ten seconds later the container is SIGKILLed mid-request.
+# Exec form makes `/usr/local/bin/app` PID 1 and puts the signal where the
+# shutdown handler is.
+CMD ["/usr/local/bin/app", "--port", "8080"]
